%% Random Forest role in NeuroWatch.
flowchart TD
    A["247 extracted EEG features<br/>19 channels x 13 features"] --> B["RF importance selector<br/>300-tree bootstrap forest"]

    B --> C["Feature importance scores<br/>rank all EEG features"]
    C --> D["Keep top 75 features<br/>selector.pkl"]

    D --> E1["RF classifier branch<br/>unscaled selected features"]
    E1 --> F1["RandomForestClassifier<br/>500 trees, max_depth = 5<br/>min_samples_leaf = 10"]
    F1 --> G1["RF class probabilities<br/>Normal, Pre-Seizure, Seizure"]

    D --> E2["SVM branch also uses<br/>the same 75 selected features"]
    E2 --> F2["SVM probability vector"]

    G1 --> H["Weighted ensemble"]
    F2 --> H
    H --> I["0.60 x RF probability<br/>+ 0.40 x SVM probability"]
    I --> J["Final class and confidence"]

    classDef input fill:#eef6ff,stroke:#2563eb,stroke-width:1px,color:#111827;
    classDef selector fill:#f4f0ff,stroke:#7c3aed,stroke-width:1px,color:#111827;
    classDef rf fill:#fff7ed,stroke:#ea580c,stroke-width:1px,color:#111827;
    classDef svm fill:#ecfdf5,stroke:#059669,stroke-width:1px,color:#111827;
    classDef ensemble fill:#fef3c7,stroke:#d97706,stroke-width:1px,color:#111827;
    classDef output fill:#fce7f3,stroke:#db2777,stroke-width:1px,color:#111827;

    class A input;
    class B,C,D selector;
    class E1,F1,G1 rf;
    class E2,F2 svm;
    class H,I ensemble;
    class J output;
